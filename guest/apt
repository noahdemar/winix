#!/bin/sh
# apt for winix: apt/apt-get/apk-style front end to the winix package repository (wasm builds, not Debian packages).
# Repository: $WINIX_REPO (default winix://pkgs, the pkgs/ directory next to the page) with index.txt lines
#   name version sha256 size deps(comma-separated or -) description...
# and archives name_version_<first 12 hex of sha256>.tar.gz, unpacked at /. Installed packages: /var/lib/apt/installed/<name> (version, then files).

REPO=${WINIX_REPO:-winix://pkgs}
LIB=/var/lib/apt
INDEX=$LIB/index.txt
DB=$LIB/installed
PROG=${0##*/}
mkdir -p "$DB"

die() { echo "E: $*" >&2; exit 100; }
# curl -sSf with retries: a download through the page's fetch occasionally drops mid-transfer
get() { curl -sSf "$@" || { sleep 1; curl -sSf "$@"; } || { sleep 2; curl -sSf "$@"; }; }

update() {
	echo "Get:1 $REPO index.txt"
	get -o "$INDEX.new" "$REPO/index.txt" || die "Failed to fetch $REPO/index.txt"
	mv "$INDEX.new" "$INDEX"
	echo "Reading package lists... Done ($(wc -l < "$INDEX") packages available)"
}

need_index() { [ -s "$INDEX" ] || update; }

# field <name> <n>: field n of the package's index line (1 = name)
field() { awk -v p="$1" -v n="$2" '$1 == p { print $n; exit }' "$INDEX"; }

installed_version() { [ -f "$DB/$1" ] && head -n 1 "$DB/$1"; }

install_one() {
	local pkg ver deps d sum file tmp # it recurses for dependencies
	pkg=$1
	ver=$(field "$pkg" 2)
	[ -n "$ver" ] || { echo "E: Unable to locate package $pkg" >&2; return 100; }
	if [ "$(installed_version "$pkg")" = "$ver" ] && [ -z "$REINSTALL" ]; then
		echo "$pkg is already the newest version ($ver)."
		return 0
	fi
	deps=$(field "$pkg" 5)
	if [ "$deps" != "-" ]; then
		for d in $(echo "$deps" | tr ',' ' '); do install_one "$d" || return $?; done
	fi
	sum=$(field "$pkg" 3)
	file=${pkg}_${ver}_$(echo "$sum" | cut -c 1-12).tar.gz
	tmp=/tmp/apt.$$.tar.gz
	echo "Get: $REPO/$file [$(field "$pkg" 4) B]"
	get -o "$tmp" "$REPO/$file" || { rm -f "$tmp"; die "Failed to fetch $file"; }
	[ "$(sha256sum "$tmp" | cut -d ' ' -f 1)" = "$sum" ] || { rm -f "$tmp"; die "Hash sum mismatch for $pkg"; }
	echo "Unpacking $pkg ($ver) ..."
	[ -f "$DB/$pkg" ] && remove_files "$pkg"
	{ echo "$ver"; tar tzf "$tmp" | grep -v '/$'; } > "$DB/$pkg.new" && tar xzf "$tmp" -C / || { rm -f "$tmp"; die "Failed to unpack $pkg"; }
	mv "$DB/$pkg.new" "$DB/$pkg"
	rm -f "$tmp"
	echo "Setting up $pkg ($ver) ..."
}

remove_files() { tail -n +2 "$DB/$1" | while read -r f; do rm -f "/${f#./}"; done; }

install() {
	[ $# -gt 0 ] || die "No packages given"
	need_index
	native= missing=
	for p; do if [ -n "$(field "$p" 2)" ]; then native="$native $p"; else missing="$missing $p"; fi; done
	for p in $native; do install_one "$p" || exit $?; done
	[ -n "$missing" ] || return 0
	if [ "${WINIX_APT_FALLBACK:-1}" != 0 ] && x86_install $missing; then return 0; fi
	for p in $missing; do echo "E: Unable to locate package $p" >&2; done
	echo "Available: $(awk '{ printf "%s ", $1 }' "$INDEX")" >&2
	exit 100
}

# --- Fallback: Alpine x86-64 packages, run under blink (x86-64 user-mode emulation) -------------------------------
# Unpacked into $X86ROOT; each command gets a wrapper in /usr/bin that runs it with $X86ROOT layered under /: paths
# resolve in the real root first (so writes land where the program asked), then fall through to the Alpine files.
ALPINE=${WINIX_ALPINE:-https://dl-cdn.alpinelinux.org/alpine/v3.20}
X86ROOT=/opt/x86
X86DB=$LIB/x86
X86INDEX=$X86DB/APKINDEX

x86_update() {
	mkdir -p "$X86DB" /tmp/apt.idx
	: > "$X86INDEX.new"
	for r in main community; do
		echo "Get: $ALPINE/$r/x86_64/APKINDEX.tar.gz"
		get -o /tmp/apt.idx/i.tgz "$ALPINE/$r/x86_64/APKINDEX.tar.gz" && tar xzf /tmp/apt.idx/i.tgz -C /tmp/apt.idx APKINDEX ||
			{ rm -rf /tmp/apt.idx "$X86INDEX.new"; return 1; }
		awk -v r="$r" '{ print } /^P:/ { print "R:" r }' /tmp/apt.idx/APKINDEX >> "$X86INDEX.new"
	done
	rm -rf /tmp/apt.idx
	mv "$X86INDEX.new" "$X86INDEX"
}

# Prints "repo name version" for the given packages and their missing dependencies, dependencies first.
# Dependencies are package names or provided names (so:libfoo.so.1, cmd:foo). Exits 1 if a requested name is unknown.
x86_resolve() {
	awk -v want="$*" -v have="$(ls "$X86DB" 2>/dev/null | grep -v '^APKINDEX' | tr '\n' ' ')" '
	BEGIN { n = split(want, W, " "); for (i = 1; i <= n; i++) Q[++q] = W[i]; m = split(have, H, " "); for (i = 1; i <= m; i++) inst[H[i]] = 1 }
	/^P:/ { name = substr($0, 3) }
	/^V:/ { ver[name] = substr($0, 3) }
	/^R:/ { repo[name] = substr($0, 3) }
	/^D:/ { deps[name] = substr($0, 3) }
	/^p:/ { k = split(substr($0, 3), P, " "); for (i = 1; i <= k; i++) { t = P[i]; sub(/=.*/, "", t); if (!(t in prov)) prov[t] = name } }
	END {
		for (h = 1; h <= q; h++) {
			t = Q[h]; sub(/[<>=~].*/, "", t)
			if (t ~ /^!/ || t == "") continue
			p = (t in ver) ? t : ((t in prov) ? prov[t] : "")
			if (p == "") { if (h <= n) { print "MISSING " t; bad = 1 }; continue }
			if (p in seen) continue
			seen[p] = 1
			if (!(p in inst)) order[++o] = p
			k = split(deps[p], D, " "); for (i = 1; i <= k; i++) Q[++q] = D[i]
		}
		if (bad) exit 1
		for (i = o; i >= 1; i--) { p = order[i]; print repo[p], p, ver[p] }
	}' "$X86INDEX"
}

x86_install() {
	[ -s "$X86INDEX" ] || x86_update || return 1
	plan=$(x86_resolve "$@") || return 1
	echo "N: Not built for winix; installing the Alpine x86-64 build (runs under blink emulation, slower)"
	command -v blink >/dev/null || install_one blink || return 1
	mkdir -p "$X86ROOT"
	echo "$plan" | while read -r repo name ver; do
		[ -n "$name" ] || continue
		apk=/tmp/apt.$$.apk
		echo "Get: $ALPINE/$repo/x86_64/$name-$ver.apk"
		get -o "$apk" "$ALPINE/$repo/x86_64/$name-$ver.apk" || { rm -f "$apk"; die "Failed to fetch $name-$ver.apk"; }
		echo "Unpacking $name ($ver) [x86-64] ..."
		tar xzf "$apk" -C "$X86ROOT" 2>/dev/null
		rm -f "$X86ROOT"/.PKGINFO "$X86ROOT"/.SIGN.* "$X86ROOT"/.pre-* "$X86ROOT"/.post-* "$X86ROOT"/.trigger
		{
			echo "$ver"
			tar tzf "$apk" 2>/dev/null | grep -v '^\.\|/$' | sed "s#^#$X86ROOT/#"
			# Wrappers for commands that do not clash with native ones.
			tar tzf "$apk" 2>/dev/null | grep -E '^(usr/)?s?bin/[^/]+$' | while read -r f; do
				c=${f##*/}
				[ -e "/usr/bin/$c" ] || [ -e "/bin/$c" ] || [ -e "/sbin/$c" ] || [ -e "/usr/sbin/$c" ] && continue
				# Run the real file by its full path: /usr/bin/$c in the real root is this wrapper.
				printf '#!/bin/sh\n# %s from Alpine %s (x86-64, via blink)\nexport BLINK_OVERLAYS=:%s\nexec blink %s/%s "$@"\n' \
					"$c" "$name" "$X86ROOT" "$X86ROOT" "$f" > "/usr/bin/$c"
				chmod 755 "/usr/bin/$c"
				echo "/usr/bin/$c"
			done
		} > "$X86DB/$name"
		rm -f "$apk"
		echo "Setting up $name ($ver) [x86-64] ..."
	done
}

remove() {
	[ $# -gt 0 ] || die "No packages given"
	for p; do
		if [ -f "$X86DB/$p" ] && [ "$p" != APKINDEX ]; then
			echo "Removing $p ($(head -n 1 "$X86DB/$p")) [x86-64] ..."
			tail -n +2 "$X86DB/$p" | while read -r f; do rm -f "$f"; done
			rm -f "$X86DB/$p"
			continue
		fi
		[ -f "$DB/$p" ] || { echo "Package '$p' is not installed, so not removed"; continue; }
		echo "Removing $p ($(installed_version "$p")) ..."
		remove_files "$p"
		rm -f "$DB/$p"
	done
}

list() {
	need_index
	while read -r name ver _ _ _ desc; do
		[ "$1" = --installed ] && [ ! -f "$DB/$name" ] && continue
		mark=; [ -f "$DB/$name" ] && mark=" [installed]"
		echo "$name/winix $ver wasm32$mark"
	done < "$INDEX"
	if [ "$1" = --installed ] && [ -d "$X86DB" ]; then
		for f in "$X86DB"/*; do
			[ -f "$f" ] && [ "${f##*/}" != APKINDEX ] && echo "${f##*/}/alpine $(head -n 1 "$f") x86_64 [installed]"
		done
	fi
}

search() {
	need_index
	grep -i -- "$1" "$INDEX" | while read -r name ver _ _ _ desc; do printf '%s/winix %s\n  %s\n' "$name" "$ver" "$desc"; done
}

show() {
	need_index
	for p; do
		line=$(awk -v p="$p" '$1 == p' "$INDEX")
		[ -n "$line" ] || die "No packages found"
		echo "$line" | { read -r name ver sum size deps desc
			printf 'Package: %s\nVersion: %s\nDepends: %s\nSize: %s\nSHA256: %s\nDescription: %s\n\n' \
				"$name" "$ver" "$deps" "$size" "$sum" "$desc"; }
	done
}

upgrade() {
	update
	for f in "$DB"/*; do
		[ -f "$f" ] || continue
		p=${f##*/}
		[ "$(installed_version "$p")" != "$(field "$p" 2)" ] && install_one "$p"
	done
	echo "All packages are up to date."
}

usage() {
	echo "usage: $PROG update | install PKG... | remove PKG... | list [--installed] | search TERM | show PKG | upgrade" >&2
	exit 1
}

# Drop options agents habitually pass (-y, -q, --no-install-recommends, ...).
args=
for a; do
	case $a in
	--reinstall) REINSTALL=1 ;;
	--installed) args="$args $a" ;;
	-*) ;;
	*) args="$args $a" ;;
	esac
done
set -- $args

if [ "$PROG" = apk ]; then
	cmd=$1; shift 2>/dev/null
	case $cmd in
	add) install "$@" ;;
	del) remove "$@" ;;
	update) update ;;
	upgrade) upgrade ;;
	search) search "$@" ;;
	info) if [ $# -gt 0 ]; then show "$@"; else list --installed; fi ;;
	*) echo "usage: apk add|del|update|upgrade|search|info" >&2; exit 1 ;;
	esac
	exit
fi

cmd=$1; shift 2>/dev/null
case $cmd in
update) update ;;
install) install "$@" ;;
remove|purge|autoremove) remove "$@" ;;
list) list "$@" ;;
search) search "$@" ;;
show) show "$@" ;;
upgrade|dist-upgrade|full-upgrade) upgrade ;;
*) usage ;;
esac
