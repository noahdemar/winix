+#ifdef __wasm__
+/*
+ * On Wasm the compiler, not this libc, lays out thread-local data: a thread
+ * finds its copy at the __tls_base global, which the kernel gives a new task
+ * from clone()'s tls argument. __musl_tp, this libc's thread pointer, is one
+ * such variable. So a new thread needs a block of its own: the initial
+ * thread-local data, with __musl_tp set to its struct pthread. (Passing the
+ * struct pthread itself as tls, as other architectures do, only appears to
+ * work while __musl_tp is the program's one thread-local variable, at offset
+ * 0, where it aliases the struct's self pointer.)
+ *
+ * __wasm_init_tls() is the linker's: it copies the initial data to the block
+ * and points the calling thread at it, which is undone here. The caller has
+ * signals blocked, so no handler runs in between.
+ */
+void __wasm_init_tls(void *);
+uintptr_t __get_tls_base(void);
+void __set_tls_base(uintptr_t);
+
+static __attribute__((__noinline__)) void wasm_thread_tls(unsigned char *block, struct pthread *td)
+{
+	uintptr_t base = __get_tls_base();
+	size_t tp_offset = (uintptr_t)&__musl_tp - base;
+	__wasm_init_tls(block);
+	__set_tls_base(base);
+	*(uintptr_t *)(block + tp_offset) = (uintptr_t)td;
+}
+#endif
