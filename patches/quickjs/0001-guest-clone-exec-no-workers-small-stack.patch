+struct exec_child_args {
+    int *std_fds;
+    const char *cwd;
+    uint32_t gid, uid;
+    const char *file;
+    BOOL use_path;
+    const char **exec_argv;
+    char **envp;
+};
+
+static int js_os_exec_child(void *arg)
+{
+    struct exec_child_args *a = arg;
+    int i;
+
+    /* remap the stdin/stdout/stderr handles if necessary */
+    for(i = 0; i < 3; i++) {
+        if (a->std_fds[i] != i) {
+            if (dup2(a->std_fds[i], i) < 0)
+                _exit(127);
+        }
+    }
+    {
+        /* Close the file handles manually, limit to 1024 */
+        int fd_max = min_int(sysconf(_SC_OPEN_MAX), 1024);
+        for(i = 3; i < fd_max; i++)
+            close(i);
+    }
+    if (a->cwd) {
+        if (chdir(a->cwd) < 0)
+            _exit(127);
+    }
+    if (a->gid != -1) {
+        if (setgid(a->gid) < 0)
+            _exit(127);
+    }
+    if (a->uid != -1) {
+        if (setuid(a->uid) < 0)
+            _exit(127);
+    }
+
+    if (a->use_path)
+        my_execvpe(a->file ? a->file : a->exec_argv[0], (char **)a->exec_argv, a->envp);
+    else
+        execve(a->file ? a->file : a->exec_argv[0], (char **)a->exec_argv, a->envp);
+    _exit(127);
+}
