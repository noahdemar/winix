+#ifdef __wasm__
+/*
+ * winix (Wasm, no MMU) has neither fork() nor vfork(). The child runs through
+ * a clone() callback instead: it shares the parent's memory, but has its own
+ * descriptors and signal handlers, and the parent waits until it execs or
+ * exits, as after vfork(). Everything the child needs was prepared before, so
+ * it only reads the parent's memory.
+ */
+#include <sched.h>
+
+struct winix_child {
+	struct child_process *cmd;
+	int need_in, need_out, need_err;
+	int *fdin, *fdout, *fderr, *notify_pipe;
+	int null_fd;
+	char **childenv;
+	struct strvec *argv;
+	struct atfork_state *as;
+};
+
+static int winix_child(void *arg)
+{
+	struct winix_child *c = arg;
+	struct child_process *cmd = c->cmd;
+	int sig;
+
+	/*
+	 * The die/error/warn routines live in the memory shared with the
+	 * parent, so they are left alone; nothing below calls them.
+	 */
+	close(c->notify_pipe[0]);
+	set_cloexec(c->notify_pipe[1]);
+	child_notifier = c->notify_pipe[1];
 
+	if (cmd->no_stdin)
+		child_dup2(c->null_fd, 0);
+	else if (c->need_in) {
+		child_dup2(c->fdin[0], 0);
+		child_close_pair(c->fdin);
+	} else if (cmd->in) {
+		child_dup2(cmd->in, 0);
+		child_close(cmd->in);
+	}
+
+	if (cmd->no_stderr)
+		child_dup2(c->null_fd, 2);
+	else if (c->need_err) {
+		child_dup2(c->fderr[1], 2);
+		child_close_pair(c->fderr);
+	} else if (cmd->err > 1) {
+		child_dup2(cmd->err, 2);
+		child_close(cmd->err);
+	}
+
+	if (cmd->no_stdout)
+		child_dup2(c->null_fd, 1);
+	else if (cmd->stdout_to_stderr)
+		child_dup2(2, 1);
+	else if (c->need_out) {
+		child_dup2(c->fdout[1], 1);
+		child_close_pair(c->fdout);
+	} else if (cmd->out > 1) {
+		child_dup2(cmd->out, 1);
+		child_close(cmd->out);
+	}
+
+	if (cmd->close_fd_above_stderr) {
+		long max_fd = sysconf(_SC_OPEN_MAX);
+		int fd;
+		if (max_fd < 0 || max_fd > 4096)
+			max_fd = 4096;
+		for (fd = 3; fd < max_fd; fd++) {
+			if (fd != child_notifier)
+				close(fd);
+		}
+	}
+
+	if (cmd->dir && chdir(cmd->dir))
+		child_die(CHILD_ERR_CHDIR);
+
+	for (sig = 1; sig < NSIG; sig++) {
+		/* ignored signals get reset to SIG_DFL on execve */
+		if (signal(sig, SIG_DFL) == SIG_IGN)
+			signal(sig, SIG_IGN);
+	}
+
+	if (sigprocmask(SIG_SETMASK, &c->as->old, NULL) != 0)
+		child_die(CHILD_ERR_SIGPROCMASK);
+
+	execve(c->argv->v[1], (char *const *) c->argv->v + 1,
+	       (char *const *) c->childenv);
+	if (errno == ENOEXEC)
+		execve(c->argv->v[0], (char *const *) c->argv->v,
+		       (char *const *) c->childenv);
+
+	if (cmd->silent_exec_failure && errno == ENOENT)
+		child_die(CHILD_ERR_SILENT);
+	child_die(CHILD_ERR_ERRNO);
+	return 127;
+}
